{
  "name": "boomerang-notifier",
  "displayName": "AI Completion Notifier - Boomerang",
  "description": "Get instant phone alerts when Cursor or VS Code AI output finishes via multi-channel push services and webhooks.",
  "version": "0.2.0",
  "icon": "assets/logo.png",
  "publisher": "gezimonkey",
  "repository": {
    "type": "git",
    "url": "https://github.com/gezimonkey/Boomerang.git"
  },
  "license": "MIT",
  "sponsor": {
    "url": "https://ko-fi.com/gezimonkey"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "boomerang.toggleMonitoring",
        "title": "Boomerang: Toggle Monitoring"
      }
    ],
    "configuration": {
      "title": "Boomerang",
      "properties": {
        "boomerang.pushChannel": {
          "type": "string",
          "default": "Webhook 通道（企业微信/钉钉/飞书/Discord/Custom Webhook）",
          "enum": [
            "PushPlus",
            "Server酱 (Turbo版)",
            "Webhook 通道（企业微信/钉钉/飞书/Discord/Custom Webhook）",
            "Bark",
            "WxPusher",
            "ntfy.sh",
            "Telegram"
          ],
          "description": "Push channel selection."
        },
        "boomerang.targetValue": {
          "type": "string",
          "default": "",
          "markdownDescription": "Target value formats by channel:\n- PushPlus: `token`\n- Server酱 (Turbo版): `sendKey`\n- Webhook channel: `webhook_url|keyword`\n- Bark: `base_url_or_key`\n- WxPusher: `AT_xxx/UID_xxx`\n- ntfy.sh: `topic`\n- Telegram: `botToken/chatId`"
        },
        "boomerang.idleTimeout": {
          "type": "number",
          "default": 8000,
          "minimum": 1000,
          "description": "Idle timeout threshold in milliseconds."
        },
        "boomerang.notificationTemplate": {
          "type": "string",
          "default": "",
          "markdownDescription": "Custom notification text. Supports `{source}` placeholder. Leave empty to use built-in humorous and friendly messages."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "boomerang.toggleMonitoring"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/vscode": "^1.90.0",
    "eslint": "^9.5.0",
    "typescript": "^5.5.4"
  }
}
